{
  "sender": "alerts@example.com",
  "from_display": "Calendar Alerts <alerts@example.com>",
  "reply_to": "you@example.com",
  "recipients": ["someone@example.com"],

  "smtp_host": "email-smtp.us-west-2.amazonaws.com",
  "smtp_port": 587,
  "smtp_user": "AKIAEXAMPLEACCESSKEY",
  "smtp_password": "derive-this-from-the-iam-secret-see-README",

  "subject": "The calendar changed",
  "highlight_pattern": "all[\\s-]*night|marathon|sold[\\s-]*out",
  "highlight_subject": "TICKETS: the show you are waiting for just appeared",
  "intro": "A watched page changed",
  "footer": "Checked every 15 minutes. You only get mail when something changes.",
  "footer_links": {
    "Schedule": "https://example.com/schedule/",
    "Tickets": "https://tickets.example.com/sessions/"
  },
  "logfile": "/var/log/watcher.log",

  "sources": [
    {
      "name": "schedule",
      "url": "https://example.com/schedule/",
      "mode": "text",
      "drop_pattern": "^(home|about|contact|privacy)$|cookie"
    },
    {
      "name": "calendar-pdf",
      "url": "https://example.com/print-calendars/",
      "mode": "links",
      "link_pattern": "[^\"]+\\.pdf"
    },
    {
      "name": "tickets",
      "url": "https://tickets.example.com/sessions/?siteToken=YOUR_TOKEN",
      "mode": "text",
      "keep_pattern": "\\b\\d{1,2}:\\d{2}\\s*(AM|PM)\\b|\\b(January|February|March|April|May|June|July|August|September|October|November|December)\\b"
    }
  ]
}
